<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:tns="https://servicos.portaldasfinancas.gov.pt/iesws/SubmeterDeclaracaoIESService/201505"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
	name="SubmeterDeclaracaoIESService"
	targetNamespace="https://servicos.portaldasfinancas.gov.pt/iesws/SubmeterDeclaracaoIESService/201505">
	
	<!-- schema -->
	
	<wsdl:types>
		<xsd:schema targetNamespace="https://servicos.portaldasfinancas.gov.pt/iesws/SubmeterDeclaracaoIESService/201505">
		
			<xsd:element name="submeterDeclaracaoIESRequest">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="versaoDeclaracao" minOccurs="1" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<!-- Exemplo: v2015.15.35.0198-qualifierGrande, 2216, etc. -->
									<xsd:maxLength value="40" />
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="declaracao" type="xsd:base64Binary" xmime:contentType="application/octet-stream" minOccurs="1" maxOccurs="1"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>

			<xsd:element name="submeterDeclaracaoIESResponse">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="codigo" type="xsd:int" minOccurs="1" maxOccurs="1"/>
						<xsd:element name="mensagem" minOccurs="0" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="256" />
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="dadosSubmissao" type="tns:informacaoSubmissao" minOccurs="0" maxOccurs="1"/>
						<xsd:element name="erros" type="tns:informacaoErros" minOccurs="0" maxOccurs="1"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		
			<xsd:element name="validarDeclaracaoIESRequest">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="versaoDeclaracao" minOccurs="1" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<!-- Exemplo: v2015.15.35.0198-qualifierGrande, 2216, etc. -->
									<xsd:maxLength value="40" />
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="declaracao" type="xsd:base64Binary" xmime:contentType="application/octet-stream" minOccurs="1" maxOccurs="1"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>

			<xsd:element name="validarDeclaracaoIESResponse">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="codigo" type="xsd:int" minOccurs="1" maxOccurs="1"/>
						<xsd:element name="mensagem" minOccurs="0" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="256" />
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="erros" type="tns:informacaoErros" minOccurs="0" maxOccurs="1"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			
			<xsd:element name="AutenticationException">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="AuthenticationFailed" minOccurs="1" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Code" type="xsd:int" minOccurs="1" maxOccurs="1"/>
									<xsd:element name="Message" type="xsd:string" minOccurs="1" maxOccurs="1"/>
									<xsd:element name="NumberOfTriesRemaining" type="xsd:int" minOccurs="1" maxOccurs="1"/>
									<xsd:element name="Actor" type="xsd:string" minOccurs="0" maxOccurs="1"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>

			<!-- complementary types -->
			
			<xsd:complexType name="informacaoSubmissao">
				<xsd:sequence>
					<xsd:element name="data" type="xsd:dateTime" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="ano" type="xsd:short" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="idDeclaracao" type="xsd:long" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="contribuinte" minOccurs="1" maxOccurs="unbounded">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Actor" minOccurs="1" maxOccurs="1">
									<xsd:simpleType>
										<xsd:restriction base="xsd:string">
											<!-- Exemplos: http://at.pt/actor/SPA, http://at.pt/actor/SPB, http://at.pt/actor/TOC -->
											<xsd:maxLength value="40" />
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="nif" type="xsd:long" minOccurs="1" maxOccurs="1"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="dadosPagamento" minOccurs="0" maxOccurs="1">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="entidade" minOccurs="1" maxOccurs="1">
									<xsd:simpleType>
										<xsd:restriction base="xsd:long">
											<!-- Exemplo: 11299 -->
											<xsd:totalDigits value="5"/>
										</xsd:restriction>
									</xsd:simpleType>								
								</xsd:element>
								<xsd:element name="referencia" minOccurs="1" maxOccurs="1">
									<xsd:simpleType>
										<xsd:restriction base="xsd:long">
											<!-- Exemplo: 202764144 -->
											<xsd:totalDigits value="9"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<!-- Exemplo: 85 que se lê e 85,00 -->
								<xsd:element name="importancia" type="xsd:long" minOccurs="1" maxOccurs="1"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
						
			<xsd:complexType name="informacaoErros">
				<xsd:sequence>
					<xsd:element name="temMaisErros" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="erro" type="tns:informacaoErro" minOccurs="1" maxOccurs="unbounded"/>
				</xsd:sequence>			
			</xsd:complexType>
			
			<xsd:complexType name="informacaoErro">
				<xsd:sequence>
					<xsd:element name="anexo" minOccurs="0" maxOccurs="1">
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<!-- Exemplos: Anexo A, Rosto, ... -->
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="quadro" minOccurs="0" maxOccurs="1">
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<!-- Exemplos: Quadro 11, Quadro 07 (Periodo 2010 e posteriores), ... -->
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="codigo" minOccurs="0" maxOccurs="1">
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<!-- Exemplos: E_PRE_NIF_CADASTRO, A40A1, C75, ... -->
								<xsd:maxLength value="20" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="mensagem" type="xsd:string" minOccurs="1" maxOccurs="1"/>
				</xsd:sequence>
			</xsd:complexType>
			
		</xsd:schema>
	</wsdl:types>
	
	<!-- wsdl -->
	
	<wsdl:message name="submeterDeclaracaoIESRequest">
		<wsdl:part element="tns:submeterDeclaracaoIESRequest" name="parameters" />
	</wsdl:message>
	
	<wsdl:message name="submeterDeclaracaoIESResponse">
		<wsdl:part element="tns:submeterDeclaracaoIESResponse" name="response" />
	</wsdl:message>
	
	<wsdl:message name="validarDeclaracaoIESRequest">
		<wsdl:part element="tns:validarDeclaracaoIESRequest" name="parameters" />
	</wsdl:message>
	
	<wsdl:message name="validarDeclaracaoIESResponse">
		<wsdl:part element="tns:validarDeclaracaoIESResponse" name="response" />
	</wsdl:message>
	
	<wsdl:message name="AutenticationFault">
		<wsdl:part element="tns:AutenticationException" name="fault" />
	</wsdl:message>
	
	<wsdl:portType name="SubmeterDeclaracaoIES">
		<wsdl:operation name="submeterDeclaracao">
			<wsdl:input message="tns:submeterDeclaracaoIESRequest" />
			<wsdl:output message="tns:submeterDeclaracaoIESResponse" />
			<wsdl:fault message="tns:AutenticationFault" name="AutenticationFault"/>
		</wsdl:operation>
		
		<wsdl:operation name="validarDeclaracao">
			<wsdl:input message="tns:validarDeclaracaoIESRequest" />
			<wsdl:output message="tns:validarDeclaracaoIESResponse" />
			<wsdl:fault message="tns:AutenticationFault" name="AutenticationFault"/>
		</wsdl:operation>
	</wsdl:portType>
	
	<wsdl:binding name="SubmeterDeclaracaoIESPortBinding" type="tns:SubmeterDeclaracaoIES">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http" />
		<wsdl:operation name="submeterDeclaracao">
			<soap:operation	soapAction="tns:submeterDeclaracao" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
			<wsdl:fault name="AutenticationFault">
				<soap:fault name="AutenticationFault" use="literal" />
			</wsdl:fault>
		</wsdl:operation>
		<wsdl:operation name="validarDeclaracao">
			<soap:operation	soapAction="tns:validarDeclaracao" />
			<wsdl:input>
				<soap:body use="literal" />
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal" />
			</wsdl:output>
			<wsdl:fault name="AutenticationFault">
				<soap:fault name="AutenticationFault" use="literal" />
			</wsdl:fault>
		</wsdl:operation>
	</wsdl:binding>
	
	<wsdl:service name="SubmeterDeclaracaoIESService">
		<wsdl:port binding="tns:SubmeterDeclaracaoIESPortBinding" name="SubmeterDeclaracaoIESPort">
			<soap:address location="https://servicos.portaldasfinancas.gov.pt/iesws/SubmeterDeclaracaoIESService/" />
		</wsdl:port>
	</wsdl:service>
	
</wsdl:definitions>
