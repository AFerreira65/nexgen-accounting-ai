<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AccountingAI.Infrastructure.Files</RootNamespace>
    <AssemblyName>AccountingAI.Infrastructure.Files</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AccountingAI.Application/AccountingAI.Application.csproj" />
    <ProjectReference Include="../AccountingAI.Domain/AccountingAI.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- Esquemas oficiais do SAF-T, colocados manualmente (ver Schemas/README.md).
         O glob não corresponde a nenhum ficheiro enquanto não forem adicionados. -->
    <EmbeddedResource Include="Schemas\SAFTPT_*.xsd" />
  </ItemGroup>
</Project>
